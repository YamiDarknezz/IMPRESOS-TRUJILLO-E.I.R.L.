# Plantilla del `.env` que vive en el VPS, junto al compose:
#   /home/yami/data/deploy/impresos/.env
#
# NUNCA se versiona. Permisos: chmod 600.
# No lo copies a mano: ejecuta ./generar-env.sh, que crea los valores aleatorios.

# ── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_DB=impresos
POSTGRES_USER=impresos
POSTGRES_PASSWORD=<<GENERAR: texto alfanumérico, sin símbolos>>

# ── Aplicación ─────────────────────────────────────────────────────────────
IMPRESOS_DOMAIN=imprenta.darknezz.dev

# ── Autenticación ──────────────────────────────────────────────────────────
# Obligatorio cambiarlo: el valor por defecto del código está publicado en
# GitHub y con él cualquiera puede firmar tokens válidos.
JWT_SECRET=<<GENERAR: python3 -c "import secrets; print(secrets.token_urlsafe(48))">>

# ── CORS ───────────────────────────────────────────────────────────────────
# La SPA y la API comparten origen (nginx reenvía /api), así que no hace falta
# CORS. Se deja el dominio igualmente por si algún día se llama desde fuera.
ALLOWED_ORIGINS=https://imprenta.darknezz.dev

# ── Reglas del negocio (ajustables sin tocar código) ───────────────────────
ADELANTO_MINIMO_PORCENTAJE=50
IGV_PORCENTAJE=18
PERU_UTC_OFFSET_HORAS=-5
JWT_EXPIRACION_MINUTOS=720
