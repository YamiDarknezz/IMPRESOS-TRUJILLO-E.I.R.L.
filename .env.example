# Variables de entorno del backend.
#
# Este archivo se versiona (documenta qué necesita el sistema para arrancar).
# El archivo real `.env` NUNCA se versiona: está en .gitignore.
#
# Los nombres coinciden con backend/app/core/config.py, que es el ÚNICO lugar
# del código donde se leen variables de entorno.
#
# Para desarrollo local, copiar a backend/.env (o usar el docker-compose.yml de
# la raíz, que ya inyecta estos valores).

# ── Aplicación ─────────────────────────────────────────────────────────────
APP_NOMBRE=API Impresos Trujillo
ENTORNO=desarrollo                 # desarrollo | pruebas | produccion
LOG_LEVEL=INFO                     # DEBUG en local, INFO o WARNING en el VPS

# ── Base de datos ──────────────────────────────────────────────────────────
# Formato: postgresql+asyncpg://usuario:clave@host:puerto/base
# En el VPS el host es el nombre del servicio de compose (`db`), no localhost.
DATABASE_URL=postgresql+asyncpg://impresos:impresos@localhost:5432/impresos

# ── CORS ───────────────────────────────────────────────────────────────────
# Varios dominios separados por coma. En producción la SPA y la API comparten
# origen (nginx reenvía /api), así que no hace falta CORS.
ALLOWED_ORIGINS=http://localhost:4200

# ── Autenticación ──────────────────────────────────────────────────────────
# GENERAR UNO NUEVO EN PRODUCCIÓN. El valor por defecto del código es público
# (está en el repositorio) y con él cualquiera podría firmar tokens válidos.
# Generar con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITMO=HS256
JWT_EXPIRACION_MINUTOS=720

# ── Reglas del negocio ─────────────────────────────────────────────────────
PERU_UTC_OFFSET_HORAS=-5
ADELANTO_MINIMO_PORCENTAJE=50
IGV_PORCENTAJE=18

# ── Solo para el contenedor (lo lee el CMD del Dockerfile) ─────────────────
PORT=8080
